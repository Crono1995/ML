import pandas as pd
from sklearn.linear_model import LinearRegression
import matplotlib.pyplot as plt

# Load dataset
df = pd.read_csv('data1.csv')

# Scatter plot for Age vs Income
plt.scatter(df.Age, df.Income, color='red', marker='+')
plt.xlabel('Age')
plt.ylabel('Income')
plt.show()

# Linear regression model
reg = LinearRegression()
reg.fit(df[['Age']], df.Income)

# Predict income for age 29
predicted_income = reg.predict([[29]])
print(f"Predicted income for a 29-year-old: {predicted_income[0]:.2f}")


